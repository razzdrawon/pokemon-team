{
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "lib": ["ES2022", "dom", "ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2022",
    "types": ["node"],
    "paths": {
      "@pokemon/contracts": ["packages/pokemon-contracts/src/index.ts"]
    }
  }
}
