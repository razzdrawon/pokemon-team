{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    // Program-wide root under nodenext: this app imports @pokemon/contracts, which lives
    // outside this package, so the root must cover both. Vite/rolldown (the real build)
    // ignores this — it's only used by tsc/tsserver for cross-package file-set validation.
    "rootDir": "../.."
  },
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "include": ["src/**/*.ts"]
}
